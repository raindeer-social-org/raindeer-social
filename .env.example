# Copy this file to .env and fill in the values you need.
# .env is gitignored; .env.example is the committed template — never put real secrets here.

# --- Database ---
# Local Postgres (16+) with the pgvector extension enabled. See README "Getting started".
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/raindeer

# --- LLM providers ---
# OpenRouter is the primary/base router (model-agnostic across Claude/GPT/Gemini).
OPENROUTER_API_KEY=
# Direct OpenAI adapter (secondary path).
OPENAI_API_KEY=
# Used by the Anthropic provider adapter when that integration lands.
ANTHROPIC_API_KEY=

# --- Provider selection (config-driven, see packages/integrations/registry.py) ---
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SERPER_API_KEY=

IMAGE_PROVIDER=fal
FAL_API_KEY=

VIDEO_PROVIDER=kling
KLING_API_KEY=

# --- App ---
ENVIRONMENT=development
